    "incidents": [
      {
        "_id": "6ad059d62dc48705ab3da0cd",
        "name": "Error loading GitLab.com and customers.gitlab.com",
        "datetime_open": "2026-10-15T04:43:02.164Z",
        "current_active": true,
        "messages": [
          {
            "details": "We're investigating an issue that's stopping pages on customers.gitlab.com from loading. Purchasing, renewing, and managing subscriptions may be affected. GitLab.com itself is not affected.",
            "state": 100,
            "status": 500,
            "datetime": "2026-10-15T04:43:02.193Z"
          },
          {
            "details": "We have received reports that some groups on GitLab.com are experiencing HTTP 500 errors because the group is unable to sync with customers.gitlab.com. We are continuing to investigate the issue.\r\n",
            "state": 100,
            "status": 500,
            "datetime": "2026-10-15T05:10:11.765Z"
          },
          {
            "details": "No material updates to report. We are still investigating the root cause.",
            "state": 100,
            "status": 500,
            "datetime": "2026-10-15T05:27:32.943Z"
          },
          {
            "details": "No material updates to report. We'll share another update when we have more information.",
            "state": 100,
            "status": 500,
            "datetime": "2026-10-15T05:50:25.648Z"
          },
          {
            "details": "Mitigations have been applied to customers.gitlab.com, and we are monitoring service availability. Intermittent errors may continue to affect Customers Portal pages and GitLab.com groups that rely on the portal for subscription-related operations. We are continuing to investigate the underlying cause and will provide another update when more information is available. More details: https://gitlab.com/gitlab-com/gl-infra/production/-/work_items/23240",
            "state": 300,
            "status": 500,
            "datetime": "2026-10-15T08:35:18.891Z"
          }
        ],
